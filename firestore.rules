rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin';
    }

    // Leitura: qualquer usuário autenticado, exceto prestacoes_contas (regra própria abaixo)
    match /{collection}/{document=**} {
      allow read: if isAuthenticated() && collection != 'prestacoes_contas';
    }

    // Escrita restrita a admins
    match /usuarios/{uid} {
      allow write: if isAdmin();
    }

    match /secoes/{id} {
      allow write: if isAdmin();
    }

    match /afastamentos_admin/{id} {
      allow write: if isAdmin();
    }

    match /afastamentos_equipe/{id} {
      allow write: if isAdmin();
    }

    match /plantao_admin/{id} {
      allow write: if isAdmin();
    }

    match /titulares_admin/{id} {
      allow write: if isAdmin();
    }

    match /defensores_admin/{id} {
      allow write: if isAdmin();
    }

    match /remocoes_admin/{id} {
      allow write: if isAdmin();
    }

    match /designacoes_cumulativas_admin/{id} {
      allow write: if isAdmin();
    }

    match /viagens_tabela1_admin/{id} {
      allow write: if isAdmin();
    }

    match /viagens_tabela2_admin/{id} {
      allow write: if isAdmin();
    }

    // Prestação de Contas: dados financeiros/pessoais sensíveis (CPF, dados bancários)
    // — leitura e escrita restritas a admin, diferente do padrão de leitura aberta acima.
    match /prestacoes_contas/{id} {
      allow read, write: if isAdmin();
    }
  }
}
